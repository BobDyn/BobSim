// Start clean
clear();

root := OpenModelica.Scripting.cd();
boblibDir := root + "/_0_Utils/external/BobLib/BobLib";
buildDir := root + "/_3_StandardSim/BuildBobLib/VehicleSim";

// Generate C simulation code
OpenModelica.Scripting.setCommandLineOptions("--simCodeTarget=C");

// Allow larger tearing systems before falling back to untorn systems
OpenModelica.Scripting.setCommandLineOptions("--maxSizeLinearTearing=5000");

// Use dynamic state selection for multibody/index-reduced systems
OpenModelica.Scripting.setCommandLineOptions("--indexReductionMethod=dynamicStateSelection");

// Set matching algorithm
OpenModelica.Scripting.setCommandLineOptions("--matchingAlgorithm=PFPlusExt");

// Match the VehicleSim class annotation used by BobLib translation tests.
OpenModelica.Scripting.setCommandLineOptions("-d=initialization,NLSanalyticJacobian");
OpenModelica.Scripting.setCommandLineOptions("--generateDynamicJacobian=none");

// Load vendored dependencies explicitly.
loadModel(Modelica, {"4.1.0"});
loadModel(VehicleInterfaces, {"2.0.2"});

// Load BobLib.
loadFile(boblibDir + "/package.mo");

mkdir(root + "/_3_StandardSim/BuildBobLib");
mkdir(buildDir);

// Go to build directory.
cd(buildDir);

// The makefile sets BOBSIM_NATIVE_CFLAGS per the container's actual
// architecture (clang on AArch64 -- e.g. Apple Silicon under Docker
// Desktop -- rejects -march=native, an x86-ism, and needs -mcpu=native
// instead). Falls back to the old default if run outside `make`.
nativeCflags := OpenModelica.Scripting.getEnvironmentVar("BOBSIM_NATIVE_CFLAGS");
nativeCflags := if nativeCflags == "" then "-O3 -march=native -mtune=native" else nativeCflags;

// Build executable directly.
res := buildModel(
  BobLib.Experiments.Standards.VehicleSim,
  startTime = 0,
  stopTime = 10,
  tolerance = 1e-6,
  outputFormat = "csv",
  cflags = nativeCflags
);

// Print build result and errors/warnings.
res;
getErrorString();
