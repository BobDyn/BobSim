.DS_Store
Thumbs.db

# Project-generated outputs
/temp/
/results/
_2_EnvelopeSim/results/**
!_2_EnvelopeSim/results/
!_2_EnvelopeSim/results/.gitkeep
_3_StandardSim/Build/
_3_StandardSim/BuildBobLib/
