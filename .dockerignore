# Build context for `docker compose build` is the whole repo (`context: .` in
# docker-compose.yml) with no other filtering, so anything not excluded here
# gets uploaded to the Docker daemon on every build. The Dockerfile only COPYs
# requirements.txt explicitly; nothing else needs to be in the context at all.

# VCS
.git/
.github/

# Python bytecode/cache
__pycache__/
*.pyc
*.py[cod]

# Host virtual environment (the image builds its own at /opt/venv)
.venv/
venv/
env/

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# IDE/editor files
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# OpenModelica/Python build and generated-result artifacts
Build/
build/
dist/
*.egg-info/
simulations/mbd/Build/
simulations/mbd/BuildBobLib/
simulations/mbd/generated_results/
simulations/mbd/results/
simulations/optimization/Build/
simulations/optimization/results/
simulations/optimization/population/
simulations/optimization/population_refined/
simulations/optimization/StandardSens/results/
simulations/optimization/EnvelopeSens/results/
simulations/envelope/results/
visualization/results/
app/user_data/
common/deploy/assets/
common/deploy/build/
common/deploy/dist/
/temp/
/results/

# Deploy/release outputs
*.exe
*.app
*.zip
*.tar.gz

# Animations
*.gif
*.mp4

simulations/lap/results/
simulations/reduced/results/
