OpenModelica.Scripting.setCommandLineOptions(
  "--simCodeTarget=C --maxSizeLinearTearing=5000"
);

clear();
loadModel(Modelica, {{"4.1.0"}});
loadModel(VehicleInterfaces, {{"2.0.2"}});
loadFile("{boblib_path}");
loadFile("{variant_mo_path}");

cd("{build_dir}");

// Pick the host-tuning flag the compiler actually accepts. clang on aarch64
// rejects -march=native and wants -mcpu=native instead, so probe rather than
// assume x86. Falling back keeps the build portable without losing tuning.
marchSupported := OpenModelica.Scripting.system("clang -march=native -x c -c /dev/null -o /dev/null > /dev/null 2>&1") == 0;
archFlags := if marchSupported then "-march=native -mtune=native" else "-mcpu=native -mtune=native";

buildModel(
  {model},
  startTime={start_time},
  stopTime={stop_time},
  outputFormat="csv",
  numberOfIntervals={intervals},
  tolerance={tolerance},
  method="{solver}",
  cflags="-O3 " + archFlags
);

print(getErrorString());
